{
  "manifest_version": 3,
  "name": "Proofr: Private AI Proofreader & Rewriter",
  "version": "1.3.0",
  "description": "Fix grammar and tone in any text box without copying it anywhere. Shows what changed. Runs on your device when Chrome supports it.",
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "activeTab",
    "clipboardWrite",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Proofr: Proofread, rewrite & translate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "proofread-selection": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "windows": "Alt+Shift+P",
        "mac": "Alt+Shift+P",
        "linux": "Alt+Shift+P",
        "chromeos": "Alt+Shift+P"
      },
      "description": "Proofread the selected text (or the whole text box if nothing is selected)"
    },
    "review-last": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Review the last Proofr change on this page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://civarry.github.io/proofr/",
  "author": "Civarry"
}
